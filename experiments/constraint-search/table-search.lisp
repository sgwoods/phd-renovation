(in-package #:constraint-search-bench)

(defun table-accepts-partial-p (constraint bindings)
  (let* ((entries (mapcar (lambda (id) (assoc id bindings :test #'equal)) (getf constraint :scope)))
         (values (mapcar #'second (remove nil entries))))
    (case (getf constraint :kind)
      (:all-different (= (length values) (length (remove-duplicates values :test #'equal))))
      (:table (or (member nil entries) (member values (getf constraint :tuples) :test #'equal))))))

(defun select-table-variable (domains constraints weights policy)
  (let ((best nil) (best-score nil))
    (dolist (variable domains best)
      (let* ((degree
               (loop for constraint in constraints for weight across weights
                     when (and (member (first variable) (getf constraint :scope) :test #'equal)
                               (>= (count-if (lambda (id) (assoc id domains :test #'equal))
                                             (getf constraint :scope)) 2)) sum weight))
             (score (/ (length (second variable)) (if (eq policy :wdeg) (max 1 degree) 1))))
        (when (or (null best-score) (< score best-score))
          (setf best variable best-score score))))))

(defun solve-table-search (instance &key (policy :wdeg) (mode :all) (cpu-seconds 5) (trace-limit 0))
  "Forward checking with deterministic MRV or domain/weighted-degree selection.
Weights start at one per solve; the last deleting constraint gets wipeout credit.
This experimental engine is not a modification of QCSP3 or a MAC implementation."
  (validate-instance instance)
  (require-model (member policy '(:mrv :wdeg)) "Unknown table-search policy.")
  (require-model (member mode '(:all :first)) "Unknown table-search mode.")
  (require-model (and (integerp cpu-seconds) (>= cpu-seconds 0)) "Invalid CPU budget.")
  (require-model (and (integerp trace-limit) (<= 0 trace-limit 10000)) "Invalid trace limit.")
  (let* ((constraints (getf instance :constraints))
         (weights (make-array (length constraints) :initial-element 1))
         (solutions nil) (nodes 0) (checks 0) (updates 0) (complete t) (reason :exhausted)
         (events nil) (event-count 0) (trace-truncated nil)
         (deadline (+ (get-internal-run-time) (* cpu-seconds internal-time-units-per-second))))
    (labels ((record-event (kind &rest fields)
               (when (plusp trace-limit)
                 (if (>= event-count trace-limit)
                     (setf trace-truncated t)
                     (let ((event (make-hash-table :test #'equal)))
                       (setf (gethash "event" event) kind (gethash "step" event) event-count)
                       (loop for (key value) on fields by #'cddr do (setf (gethash key event) value))
                       (incf event-count) (push event events)))))
             (domain-snapshot (domains)
               (let ((snapshot (make-hash-table :test #'equal)))
                 (dolist (variable domains snapshot)
                   (setf (gethash (first variable) snapshot) (coerce (second variable) 'vector)))))
             (weight-snapshot ()
               (let ((snapshot (make-hash-table :test #'equal)))
                 (loop for c in constraints for w across weights do
                   (setf (gethash (getf c :id) snapshot) w)) snapshot))
             (budget ()
               (when (>= (get-internal-run-time) deadline)
                 (setf complete nil reason :cpu-limit) (throw 'done nil)))
             (accepts (c bindings)
               (budget) (incf checks) (table-accepts-partial-p c bindings))
             (blame (index)
               (incf (aref weights index)) (incf updates)
               (when (plusp trace-limit)
                 (record-event "failure" "constraint" (getf (nth index constraints) :id)
                               "new_weight" (aref weights index))))
             (propagate (domains bindings)
               (let ((next (copy-tree domains)))
                 (dolist (variable next next)
                   (unless (second variable) (return-from propagate nil))
                   (loop for c in constraints for index from 0 do
                     (when (member (first variable) (getf c :scope) :test #'equal)
                       (setf (second variable)
                             (remove-if-not (lambda (v) (accepts c (acons (first variable) (list v) bindings)))
                                            (second variable)))
                       (unless (second variable) (blame index) (return-from propagate nil)))))))
             (visit (domains bindings)
               (budget)
               (unless domains
                 (push (reverse bindings) solutions)
                 (record-event "solution" "depth" (length bindings))
                 (when (eq mode :first)
                   (setf complete nil reason :first-witness) (throw 'done nil))
                 (return-from visit nil))
               (let* ((variable (select-table-variable domains constraints weights policy))
                      (remaining (remove variable domains :test #'eq)))
                 (when (plusp trace-limit)
                   (record-event "choose" "variable" (first variable) "depth" (length bindings)
                                 "domains" (domain-snapshot domains) "weights" (weight-snapshot)))
                 (dolist (value (second variable))
                   (budget) (incf nodes)
                   (record-event "assign" "variable" (first variable) "value" value "depth" (length bindings))
                   (let ((bound (cons (list (first variable) value) bindings)) (valid t))
                     (loop for c in constraints for index from 0 do
                       (unless (accepts c bound) (blame index) (setf valid nil) (return)))
                     (when valid
                       (if remaining
                           (let ((filtered (propagate remaining bound)))
                             (when filtered (visit filtered bound)))
                           (visit nil bound)))
                     (record-event "backtrack" "variable" (first variable) "value" value "depth" (length bindings)))))))
      (catch 'done
        (let ((variables (getf instance :variables)))
          (cond ((null variables) (setf solutions (list nil)))
                ((some (lambda (v) (null (second v))) variables) nil)
                (t (let ((filtered (propagate variables nil)))
                     (when filtered (visit filtered nil))))))))
    (list :status (cond (solutions :sat) (complete :unsat) (t :unknown))
          :complete complete :termination reason :solutions (nreverse solutions)
          :nodes nodes :pair-checks nil :constraint-tests checks :weight-updates updates
          :weights (loop for c in constraints for w across weights collect (list (getf c :id) w))
          :trace (nreverse events) :trace-truncated trace-truncated
          :raw-status nil)))
