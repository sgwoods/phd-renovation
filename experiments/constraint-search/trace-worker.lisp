(require :asdf)
(defparameter *here* (uiop:pathname-directory-pathname (truename *load-pathname*)))
(load (merge-pathnames "model.lisp" *here*))
(load (merge-pathnames "table-search.lisp" *here*))
(in-package #:constraint-search-bench)
(destructuring-bind (path policy-text) (uiop:command-line-arguments)
  (let* ((instance (read-instance path))
         (policy (cond ((equal policy-text "mrv") :mrv) ((equal policy-text "wdeg") :wdeg)
                       ((equal policy-text "degree") :degree)
                       (t (error "Unknown trace policy"))))
         (result (solve-table-search instance :policy policy :trace-limit 1000))
         (plain (solve-table-search instance :policy policy))
         (oracle (enumerate-instance instance))
         (object (make-hash-table :test #'equal)))
    (require-model (and (getf result :complete) (getf plain :complete) (getf oracle :complete)
                        (same-solutions-p (getf result :solutions) (getf oracle :solutions))
                        (= (getf plain :nodes) (getf result :nodes))
                        (= (getf plain :constraint-tests) (getf result :constraint-tests))
                        (equal (getf plain :weights) (getf result :weights))) "Trace changed search behavior.")
    (loop for (key value) on (list "instance_id" (getf instance :id) "policy" policy-text
                                  "status" (symbol-name (getf result :status)) "nodes" (getf result :nodes)
                                  "constraint_tests" (getf result :constraint-tests)
                                  "weight_updates" (getf result :weight-updates)
                                  "truncated" (if (getf result :trace-truncated) :true :false)
                                  "events" (coerce (getf result :trace) 'vector)) by #'cddr do
      (setf (gethash key object) value))
    (write-json object) (terpri)))
