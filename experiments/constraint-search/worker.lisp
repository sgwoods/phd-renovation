;;;; One isolated SBCL worker per input/configuration; stdout is one JSON record.
(require :asdf)
(defparameter *benchmark-directory*
  (uiop:pathname-directory-pathname (truename *load-pathname*)))
(pushnew (truename (merge-pathnames "../../" *benchmark-directory*)) asdf:*central-registry* :test #'equal)
(let ((*standard-output* *error-output*))
  (asdf:load-system :qcsp3)
  (load (merge-pathnames "model.lisp" *benchmark-directory*))
  (load (merge-pathnames "qcsp3-adapter.lisp" *benchmark-directory*))
  (load (merge-pathnames "table-search.lisp" *benchmark-directory*)))

(in-package #:constraint-search-bench)

(defun json-object (&rest fields)
  (let ((table (make-hash-table :test #'equal)))
    (loop for (key value) on fields by #'cddr do (setf (gethash key table) value))
    table))

(handler-case
    (destructuring-bind (path strategy-name mode-name cpu-string) (uiop:command-line-arguments)
      (let* ((instance (read-instance path))
             (strategy (cdr (assoc strategy-name '(("bt" . :bt) ("fc" . :fc)
                                                    ("fcdr" . :fcdr) ("fcdr-as" . :fcdr-as)
                                                    ("table-mrv" . :mrv) ("table-degree" . :degree) ("table-wdeg" . :wdeg))
                                   :test #'equal)))
             (mode (cdr (assoc mode-name '(("all" . :all) ("first" . :first)) :test #'equal)))
             (start (get-internal-real-time))
             (result (if (member strategy '(:mrv :degree :wdeg))
                         (solve-table-search instance :policy strategy :mode mode :cpu-seconds (parse-integer cpu-string))
                         (solve-qcsp3 instance :strategy strategy :mode mode :cpu-seconds (parse-integer cpu-string))))
             (solved (get-internal-real-time))
             (solutions (getf result :solutions))
             (valid (every (lambda (assignment) (check-assignment instance assignment)) solutions))
             (oracle (enumerate-instance instance))
             (same-set (and (getf oracle :complete) (getf result :complete)
                            (same-solutions-p solutions (getf oracle :solutions)))))
        (unless valid (error "Backend returned an invalid witness."))
        (when (and (getf oracle :complete) (getf result :complete) (not same-set))
          (error "Backend/oracle solution sets differ."))
        (write-json
         (json-object
          "schema_version" 1 "instance_id" (getf instance :id)
          "provenance" (getf instance :provenance) "status" (symbol-name (getf result :status))
          "termination" (symbol-name (getf result :termination))
          "complete" (if (getf result :complete) :true :false)
          "solution_count" (length solutions)
          "solutions" (coerce (mapcar (lambda (assignment)
                                        (apply #'json-object (loop for (key value) in assignment append (list key value))))
                                      solutions) 'vector)
          "witnesses_valid" (if solutions (if valid :true :false) nil)
          "oracle_complete" (if (getf oracle :complete) :true :false)
          "oracle_solution_count" (length (getf oracle :solutions))
          "parity" (if (and (getf result :complete) (getf oracle :complete))
                         (if same-set :true :false) nil)
          "solve_ticks" (- solved start)
          "verification_ticks" (- (get-internal-real-time) solved)
          "ticks_per_second" internal-time-units-per-second
          "legacy_raw_status" (symbol-name (getf result :raw-status))
          "nodes_visited" (getf result :nodes) "adapter_pair_checks" (getf result :pair-checks)
          "table_constraint_tests" (getf result :constraint-tests)
          "weight_updates" (getf result :weight-updates)
          "failure_events" (getf result :failure-events)
          "final_weights" (when (getf result :weights)
                            (apply #'json-object (loop for (id weight) in (getf result :weights) append (list id weight))))
          "lisp_version" (lisp-implementation-version)))
        (terpri)))
  (error (condition)
    (write-json (json-object "schema_version" 1 "status" "ERROR" "reason" (princ-to-string condition)))
    (terpri)
    (uiop:quit 1)))
