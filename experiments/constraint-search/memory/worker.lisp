;;;; Isolated two-stage audit; does not replace the historical memory-search.
(require :asdf)
(defparameter *here* (uiop:pathname-directory-pathname (truename *load-pathname*)))
(defparameter *bench* (merge-pathnames "../" *here*))
(defparameter *root* (truename (merge-pathnames "../../../" *here*)))
(pushnew *root* asdf:*central-registry* :test #'equal)
(let ((*standard-output* *error-output*))
  (asdf:load-system :qcsp3)
  (dolist (file '("model.lisp" "qcsp3-adapter.lisp" "historical-export.lisp"))
    (load (merge-pathnames file *bench*))))
(in-package #:constraint-search-bench)

(defun memory-object (&rest fields)
  (let ((object (make-hash-table :test #'equal)))
    (loop for (key value) on fields by #'cddr do (setf (gethash key object) value)) object))
(defun mappings-json (solutions)
  (coerce (mapcar (lambda (s) (apply #'memory-object (loop for pair in s append pair))) solutions) 'vector))
(defun extends-index-p (full partial)
  (every (lambda (pair) (equal (second pair) (second (assoc (first pair) full :test #'equal)))) partial))

(defun prepared-model (id template prepared)
  (setf qcsp3::*current-template* (copy-tree (qcsp3::get-templ-object template))
        qcsp3::*current-situation* (copy-tree prepared))
  (require-model (supported-historical-constraints-p "adt" qcsp3::*current-template*)
                 "Unreviewed index/full constraint.")
  (let* ((variables (qcsp3::node-consistent-variables (qcsp3::adt-variables) :force nil))
         (model (export-prepared-model id variables)))
    (values model (audit-export model variables))))

(defun adt-stage (prepared template &optional partial)
  (let ((*default-pathname-defaults* (merge-pathnames "qcsp3/" cl-user::*root*))
        (*standard-output* (make-broadcast-stream)))
    (ensure-directories-exist "ADT-Random/placeholder")
    (copy-tree
     (qcsp3:adt :situation-id "special" :override-situation (copy-tree prepared)
                :template-id template :part-soln partial :sit-noise 0 :random-ident "unique"
                :one-solution-only nil :cpu-sec-limit 10 :advance-sort nil
                :sort-const nil :adv-sort-const nil :forward-checking t :dynamic-rearrangement t))))

(handler-case
    (destructuring-bind (name &optional prepared-file) (uiop:command-line-arguments)
      (require-model (member name '("adt-base" "adt-two") :test #'equal)
                     "Only reviewed ADT native anchors are supported.")
      (multiple-value-bind (case original base) (prepare-historical-case name cl-user::*root*)
        (declare (ignore original))
        (let* ((prepared (if prepared-file
                             (with-open-file (stream prepared-file)
                               (let ((*read-eval* nil) (*package* (find-package :qcsp3))) (read stream)))
                             base))
               (index-template "quilici-t1-index") (full-template "quilici-t1")
               (groups nil) (union nil))
          (multiple-value-bind (full-model full-audit) (prepared-model "full" full-template prepared)
            (multiple-value-bind (index-model index-audit) (prepared-model "index" index-template prepared)
              (let* ((full-oracle (enumerate-instance full-model))
                     (index-oracle (enumerate-instance index-model))
                     (full (getf full-oracle :solutions))
                     (index (adt-stage prepared index-template))
                     (index-strings (string-mappings index))
                     (direct (string-mappings (adt-stage prepared full-template))))
                (require-model (and (getf full-oracle :complete) (getf index-oracle :complete)
                                    (same-solutions-p index-strings (getf index-oracle :solutions))
                                    (same-solutions-p direct full)) "Index/direct oracle mismatch.")
                (require-model (every (lambda (s) (some (lambda (p) (extends-index-p s p)) index-strings)) full)
                               "Index lost a full match.")
                (dolist (partial index)
                  (let* ((partial-strings (first (string-mappings (list partial))))
                         (completed (string-mappings (adt-stage prepared full-template partial)))
                         (expected (remove-if-not (lambda (s) (extends-index-p s partial-strings)) full)))
                    (require-model (same-solutions-p expected completed) "Per-index completion mismatch.")
                    (setf union (append union completed))
                    (push (memory-object "index" (aref (mappings-json (list partial-strings)) 0)
                                         "completions" (mappings-json completed)) groups)))
                (require-model (same-solutions-p union full) "Two-stage union mismatch or duplicates.")
                (unless prepared-file
                  (let* ((*default-pathname-defaults* (merge-pathnames "qcsp3/" cl-user::*root*))
                         (*standard-output* (make-broadcast-stream))
                         (native (qcsp3:memory-search index-template full-template
                                    :situation-id (third case) :sit-noise 0 :random-ident "unique"
                                    :memory-key nil :2-advance-sort nil :2-sort-const nil :2-adv-sort-const nil)))
                    (require-model (same-solutions-p (string-mappings (apply #'append native)) full)
                                   "Original memory-search mismatch.")))
                (write-json (memory-object "case" name "controlled_input" (if prepared-file :true :false)
                    "original_memory_search_parity" (if prepared-file nil :true)
                    "index_assignments_audited" index-audit "full_assignments_audited" full-audit
                    "index_solutions" (mappings-json index-strings) "direct_solutions" (mappings-json direct)
                    "groups" (coerce (nreverse groups) 'vector) "union" (mappings-json union)
                    "index_recall_complete" :true "per_index_parity" :true "union_parity" :true))
                (terpri)))))))
  (error (condition) (format *error-output* "~A~%" condition) (uiop:quit 1)))
