;;;; Controlled historical-derived situations; never edits legacy source or goldens.
(require :asdf)
(defparameter *here* (uiop:pathname-directory-pathname (truename *load-pathname*)))
(defparameter *root* (truename (merge-pathnames "../../" *here*)))
(pushnew *root* asdf:*central-registry* :test #'equal)
(let ((*standard-output* *error-output*))
  (asdf:load-system :qcsp3)
  (dolist (file '("model.lisp" "qcsp3-adapter.lisp" "historical-export.lisp"))
    (load (merge-pathnames file *here*))))
(in-package #:constraint-search-bench)

(defun noise-symbol (name) (intern name :qcsp3))
(defun noise-data (value)
  (with-standard-io-syntax
    (let ((*package* (find-package :qcsp3)) (*print-readably* nil)) (prin1-to-string value))))
(defun noise-object (&rest fields)
  (let ((object (make-hash-table :test #'equal)))
    (loop for (key value) on fields by #'cddr do (setf (gethash key object) value)) object))

(defun make-noisy-situation (original seed level variant)
  "LCG v1 controls block order; each near-plan differs in one index dependency."
  (require-model (and (<= 0 seed 4) (<= 0 level 2)
                      (member variant '("positive" "negative" "ambiguous" "renamed") :test #'equal)
                      (or (not (equal variant "ambiguous")) (plusp level))) "Invalid noise configuration.")
  (let* ((state (+ seed 1)) (blocks nil) (expected nil)
         (names '(qcsp3::a qcsp3::idx qcsp3::result qcsp3::block1 qcsp3::elemb qcsp3::elem)))
    (dotimes (block (1+ level))
      (let* ((prefix (if (zerop block) "ADTQ1-" (format nil "N~D-~D-" seed block)))
             (rename (or (plusp block) (equal variant "renamed")))
             (substitutions (when rename
                              (mapcar (lambda (name) (cons name (noise-symbol (format nil "~A~A" prefix name)))) names)))
             (broken (if (zerop block) (equal variant "negative")
                         (not (and (= block 1) (equal variant "ambiguous")))))
             (statements (copy-tree original)))
        (dolist (row statements)
          (setf (first row) (noise-symbol (concatenate 'string prefix (subseq (symbol-name (first row)) 6)))
                (third row) (sublis substitutions (third row)))
          (when (and broken (eq (first (third row)) 'qcsp3::increment))
            (setf (second (third row)) (noise-symbol (concatenate 'string prefix "BROKEN-IDX")))))
        (unless broken
          (push (loop for suffix in '("A" "B" "C" "D" "E" "F" "G" "H" "I")
                      collect (list (concatenate 'string "Q1-" suffix) (concatenate 'string prefix suffix))) expected))
        (push statements blocks)))
    (setf blocks (coerce (nreverse blocks) 'vector))
    (loop for i downfrom (1- (length blocks)) above 0 do
      (setf state (mod (+ (* state 1664525) 1013904223) 4294967296))
      (rotatef (aref blocks i) (aref blocks (mod (ash state -16) (1+ i)))))
    (values (loop for block across blocks for position from 0 append
              (loop for row in block collect
                (list (first row) (+ (* position 1000) (second row)) (third row))))
            (nreverse expected))))

(handler-case
    (destructuring-bind (seed-text level-text variant) (uiop:command-line-arguments)
      (let* ((seed (parse-integer seed-text)) (level (parse-integer level-text))
             (id (format nil "noise-s~D-n~D-~A" seed level variant))
             (start (get-internal-real-time)))
        (multiple-value-bind (case original) (prepare-historical-case "adt-base" cl-user::*root*)
          (declare (ignore case))
          (multiple-value-bind (situation expected) (make-noisy-situation original seed level variant)
            (let* ((prepared (qcsp3::restructure-line-numbers situation))
                   (template (copy-tree qcsp3::*current-template*)))
              (setf qcsp3::*current-situation* prepared)
              (let* ((raw (qcsp3::adt-variables))
                     (variables (qcsp3::node-consistent-variables raw :force nil))
                     (model (export-prepared-model id variables))
                     (encoded (get-internal-real-time))
                     (audited (audit-export model variables))
                     (legacy (solve-historical variables))
                     (oracle (enumerate-instance model)))
                (require-model (and (getf oracle :complete)
                                    (same-solutions-p expected legacy)
                                    (same-solutions-p expected (getf oracle :solutions)))
                               "Generated situation changed the expected match set.")
                (let ((*default-pathname-defaults* (merge-pathnames "qcsp3/" cl-user::*root*))
                      (*standard-output* (make-broadcast-stream)))
                  (ensure-directories-exist "ADT-Random/placeholder")
                  (qcsp3:adt :situation-id "special" :override-situation (copy-tree prepared)
                             :template-id "quilici-t1" :sit-noise 0 :random-ident "unique"
                             :one-solution-only nil :cpu-sec-limit 10 :advance-sort nil
                             :sort-const nil :adv-sort-const nil :forward-checking nil :dynamic-rearrangement nil))
                (require-model (same-solutions-p expected (string-mappings qcsp3::*solution-set*))
                               "Generated original-entrypoint parity failed.")
                (write-json
                 (noise-object "id" id "seed" seed "noise_blocks" level "added_statements" (* level 9)
                  "variant" variant "generator" "adt-near-plan-v1" "provenance" "historical-derived"
                  "template" (noise-data template) "original_situation" (noise-data original)
                  "generated_situation" (noise-data situation) "prepared_situation" (noise-data prepared)
                  "raw_variables" (noise-data raw) "filtered_variables" (noise-data variables)
                  "type_catalog" (noise-data qcsp3::*actual-type-lst*)
                  "expected_solutions" (coerce (mapcar (lambda (mapping)
                                                       (apply #'noise-object (loop for pair in mapping append pair))) expected) 'vector)
                  "expected_solution_count" (length expected) "assignments_audited" audited
                  "original_entrypoint_parity" :true "oracle_parity" :true
                  "instance_sexp" (noise-data model)
                  "export_ticks" (- encoded start)
                  "audit_ticks" (- (get-internal-real-time) encoded)
                  "ticks_per_second" internal-time-units-per-second))
                (terpri)))))))
  (error (condition) (format *error-output* "~A~%" condition) (uiop:quit 1)))
