(defpackage #:constraint-search-bench
  (:use #:cl)
  (:export #:read-instance #:validate-instance #:check-assignment #:enumerate-instance
           #:solve-qcsp3 #:invalid-instance #:unsupported-instance #:write-json))
(in-package #:constraint-search-bench)

(define-condition invalid-instance (error)
  ((reason :initarg :reason :reader reason))
  (:report (lambda (condition stream) (write-string (reason condition) stream))))
(define-condition unsupported-instance (invalid-instance) ())

(defun require-model (test message)
  (unless test (error 'invalid-instance :reason message)))

(defun proper-list-p (value)
  (handler-case (integerp (list-length value)) (type-error () nil)))

(defun fields-p (object required &optional optional)
  (and (proper-list-p object) (evenp (length object))
       (let ((keys (loop for tail on object by #'cddr collect (first tail))))
         (and (= (length keys) (length (remove-duplicates keys)))
              (every (lambda (key) (member key keys)) required)
              (every (lambda (key) (member key (append required optional))) keys)))))

(defun unique-list-p (values)
  (and (proper-list-p values)
       (= (length values) (length (remove-duplicates values :test #'equal)))))

(defun id-p (value)
  (and (stringp value) (plusp (length value))))

(defun validate-instance (instance)
  "Validate a finite, declarative model. Unknown fields are errors, not hints."
  (require-model (fields-p instance '(:schema-version :id :provenance :variables :constraints))
                 "Unexpected, duplicate or missing instance fields.")
  (require-model (eql (getf instance :schema-version) 1) "Unsupported schema version.")
  (require-model (id-p (getf instance :id)) "Instance ID must be a nonempty string.")
  (require-model (member (getf instance :provenance)
                         '("historical" "historical-derived" "new-synthetic" "real-source")
                         :test #'equal) "Invalid provenance category.")
  (let ((variables (getf instance :variables)) (constraints (getf instance :constraints)))
    (require-model (proper-list-p variables) "Variables must be a proper list.")
    (dolist (variable variables)
      (require-model (and (proper-list-p variable) (= (length variable) 2)
                          (id-p (first variable)) (unique-list-p (second variable))
                          (every #'id-p (second variable)))
                     "A variable must contain an ID and a duplicate-free string domain."))
    (require-model (unique-list-p (mapcar #'first variables)) "Duplicate variable IDs.")
    (require-model (proper-list-p constraints) "Constraints must be a proper list.")
    (dolist (constraint constraints)
      (require-model (fields-p constraint '(:id :kind :scope) '(:tuples))
                     "Unexpected, duplicate or missing constraint fields.")
      (require-model (id-p (getf constraint :id)) "Invalid constraint ID.")
      (let ((scope (getf constraint :scope)) (kind (getf constraint :kind)))
        (require-model (and scope (unique-list-p scope)
                            (every (lambda (id) (assoc id variables :test #'equal)) scope))
                       "Scope must name distinct declared variables.")
        (case kind
          (:all-different
           (require-model (not (member :tuples constraint)) "Distinctness has no tuple field."))
          (:table
           (require-model (member :tuples constraint) "A table requires explicit tuples.")
           (require-model (unique-list-p (getf constraint :tuples)) "Invalid or duplicate tuples.")
           (dolist (tuple (getf constraint :tuples))
             (require-model (and (proper-list-p tuple) (= (length tuple) (length scope))
                                 (every (lambda (id value)
                                          (member value (second (assoc id variables :test #'equal))
                                                  :test #'equal)) scope tuple))
                            "Tuple arity or domain membership is invalid.")))
          (otherwise (error 'unsupported-instance :reason "Unsupported constraint kind.")))))
    (require-model (unique-list-p (mapcar (lambda (c) (getf c :id)) constraints))
                   "Duplicate constraint IDs."))
  instance)

(defun read-instance (path)
  "Read trusted local data, never evaluate it. Dispatch syntax (#.) is forbidden."
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil))
        (*package* (find-package :constraint-search-bench)) (eof (gensym)))
    (set-macro-character #\# (lambda (stream character)
                              (declare (ignore stream character))
                              (error 'invalid-instance :reason "Reader dispatch is forbidden.")))
    (with-open-file (stream path)
      (let ((instance (read stream nil eof)))
        (require-model (not (eq instance eof)) "Empty instance file.")
        (require-model (eq (read stream nil eof) eof) "Trailing instance data.")
        (validate-instance instance)))))

(defun assignment-failures (instance assignment)
  ;; This checker inspects complete assignments only; it shares no pruning code
  ;; or compiled pair relations with the QCSP3 adapter.
  (let ((variables (getf instance :variables)) (failures nil))
    (unless (and (proper-list-p assignment)
                 (every (lambda (pair) (and (proper-list-p pair) (= (length pair) 2))) assignment)
                 (unique-list-p (mapcar #'first assignment))
                 (= (length assignment) (length variables))
                 (every (lambda (pair) (assoc (first pair) variables :test #'equal)) assignment))
      (return-from assignment-failures (list :assignment-shape)))
    (dolist (variable variables)
      (unless (member (second (assoc (first variable) assignment :test #'equal))
                      (second variable) :test #'equal)
        (push (list :domain (first variable)) failures)))
    (dolist (constraint (getf instance :constraints))
      (let ((values (mapcar (lambda (id) (second (assoc id assignment :test #'equal)))
                            (getf constraint :scope))))
        (unless (case (getf constraint :kind)
                  (:all-different (unique-list-p values))
                  (:table (member values (getf constraint :tuples) :test #'equal)))
          (push (getf constraint :id) failures))))
    (nreverse failures)))

(defun check-assignment (instance assignment)
  "Return validity and a list of violated constraint IDs or structural errors."
  (validate-instance instance)
  (let ((failures (assignment-failures instance assignment)))
    (values (null failures) failures)))

(defun enumerate-instance (instance &key (max-assignments 100000))
  "Independent Cartesian-product oracle, deliberately without propagation."
  (validate-instance instance)
  (require-model (and (integerp max-assignments) (>= max-assignments 0)) "Invalid oracle budget.")
  (let ((solutions nil) (checked 0) (complete t))
    (labels ((visit (variables assignment)
               (if variables
                   (dolist (value (second (first variables)))
                     (visit (rest variables) (cons (list (first (first variables)) value) assignment)))
                   (progn
                     (when (>= checked max-assignments)
                       (setf complete nil)
                       (throw 'budget nil))
                     (incf checked)
                     (unless (assignment-failures instance assignment)
                       (push (reverse assignment) solutions))))))
      (catch 'budget (visit (getf instance :variables) nil)))
    (list :status (cond (solutions :sat) (complete :unsat) (t :unknown))
          :complete complete :termination (if complete :exhausted :assignment-limit)
          :solutions (nreverse solutions) :assignments-checked checked)))

(defun same-solutions-p (left right)
  "Order-insensitive equality, rejecting duplicate answers instead of hiding them."
  (flet ((same-assignment (a b)
           (and (= (length a) (length b)) (every (lambda (pair) (member pair b :test #'equal)) a))))
    (and (= (length left) (length right))
         (= (length left) (length (remove-duplicates left :test #'same-assignment)))
         (subsetp left right :test #'same-assignment)
         (subsetp right left :test #'same-assignment))))

(defun write-json (value &optional (stream *standard-output*))
  "Small output-only encoder: hash tables, vectors, strings, integers and JSON keywords."
  (labels ((string-value (s)
             (write-char #\" stream)
             (loop for character across s do
               (case character
                 (#\" (write-string "\\\"" stream))
                 (#\\ (write-string "\\\\" stream))
                 (otherwise (if (< (char-code character) 32)
                                (format stream "\\u~4,'0X" (char-code character))
                                (write-char character stream)))))
             (write-char #\" stream)))
    (cond ((stringp value) (string-value value))
          ((integerp value) (format stream "~D" value))
          ((eq value :true) (write-string "true" stream))
          ((eq value :false) (write-string "false" stream))
          ((null value) (write-string "null" stream))
          ((hash-table-p value)
           (write-char #\{ stream)
           (let ((first t))
             (maphash (lambda (key item)
                        (unless first (write-char #\, stream))
                        (setf first nil)
                        (string-value key) (write-char #\: stream) (write-json item stream)) value))
           (write-char #\} stream))
          ((vectorp value)
           (write-char #\[ stream)
           (loop for item across value for i from 0 do
             (unless (zerop i) (write-char #\, stream)) (write-json item stream))
           (write-char #\] stream))
          (t (error "Unsupported JSON value: ~S" value)))))
