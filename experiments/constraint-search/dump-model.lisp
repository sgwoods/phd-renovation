;;;; Validated, bounded Lisp-to-JSON bridge for optional external backends.
(require :asdf)
(load (merge-pathnames "model.lisp" (uiop:pathname-directory-pathname *load-pathname*)))
(in-package #:constraint-search-bench)
(defun object (&rest fields)
  (let ((o (make-hash-table :test #'equal)))
    (loop for (key value) on fields by #'cddr do (setf (gethash key o) value)) o))
(let* ((instance (read-instance (first (uiop:command-line-arguments))))
       (oracle (enumerate-instance instance)))
  (write-json
   (object "id" (getf instance :id) "provenance" (getf instance :provenance)
           "variables" (coerce (mapcar (lambda (v) (object "id" (first v) "domain" (coerce (second v) 'vector)))
                                       (getf instance :variables)) 'vector)
           "constraints" (coerce (mapcar (lambda (c)
                                           (object "id" (getf c :id) "kind" (symbol-name (getf c :kind))
                                                   "scope" (coerce (getf c :scope) 'vector)
                                                   "tuples" (coerce (mapcar (lambda (tuple) (coerce tuple 'vector))
                                                                            (getf c :tuples)) 'vector)))
                                         (getf instance :constraints)) 'vector)
           "oracle_complete" (if (getf oracle :complete) :true :false)
           "oracle_solutions" (coerce (mapcar (lambda (assignment)
                                                 (apply #'object (loop for (id value) in assignment append (list id value))))
                                               (getf oracle :solutions)) 'vector)))
  (terpri))
