(require :asdf)
(defparameter *here* (uiop:pathname-directory-pathname (truename *load-pathname*)))
(defparameter *root* (truename (merge-pathnames "../../" *here*)))
(pushnew *root* asdf:*central-registry* :test #'equal)
(let ((*standard-output* *error-output*))
  (asdf:load-system :qcsp3)
  (load (merge-pathnames "model.lisp" *here*))
  (load (merge-pathnames "qcsp3-adapter.lisp" *here*))
  (load (merge-pathnames "historical-export.lisp" *here*)))

(in-package #:constraint-search-bench)
(defun export-object (&rest fields)
  (let ((object (make-hash-table :test #'equal)))
    (loop for (key value) on fields by #'cddr do (setf (gethash key object) value))
    object))
(defun data-string (value)
  (with-standard-io-syntax
    (let ((*package* (find-package :qcsp3)) (*print-readably* nil)) (prin1-to-string value))))
(handler-case
    (multiple-value-bind (case original prepared raw variables)
        (prepare-historical-case (first (uiop:command-line-arguments)) cl-user::*root*)
      (let* ((model (export-prepared-model (first case) variables))
             (checked (audit-export model variables))
             (legacy (solve-historical variables))
             (oracle (enumerate-instance model))
             (converted (solve-qcsp3 model))
             (top-level (solve-original-entrypoint case cl-user::*root*)))
        (require-model (and (getf oracle :complete) (getf converted :complete)
                            (same-solutions-p legacy top-level)
                            (same-solutions-p legacy (getf oracle :solutions))
                            (same-solutions-p legacy (getf converted :solutions)))
                       "Historical search/export/oracle parity failed.")
        (write-json
         (export-object
          "case" (first case) "domain" (second case) "situation" (third case) "template" (fourth case)
          "noise" 0 "node_force_all" :false "randomization" nil "top_level_parity" :true
          "type_catalog" (when (equal (second case) "adt") (data-string qcsp3::*actual-type-lst*))
          "original_situation" (data-string original) "prepared_situation" (data-string prepared)
          "original_template" (data-string qcsp3::*current-template*)
          "raw_variables" (data-string raw) "filtered_variables" (data-string variables)
          "instance_sexp" (data-string model) "assignments_audited" checked
          "expected_solutions" (data-string legacy) "solution_count" (length legacy)
          "parity" :true))
        (terpri)))
  (error (condition) (format *error-output* "~A~%" condition) (uiop:quit 1)))
