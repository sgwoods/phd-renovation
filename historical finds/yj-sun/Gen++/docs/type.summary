  CA_Abstract


Actual        # Template actual parameter (for instantiations)
  ExprActual        # Actual value parameter
  TypeActual        # Actual type parameter


Parameter        # Template formal parameter
  ValueParameter        # Template value parameter
  TypeParameter        # Template type parameter


Statement        # Generic statement
  Try        # Try statement (not implemented in 3.0)
  Goto
  LabelStmt        # Generic statement label
    Default        # Switch default
    Case        # Case label
    Label
  Continue
  Break
  Switch
  Do
  For
  While
  If
  Block        # Explicit or compiler generated block
  Return
  NullStmt        # Null or missing statement
  ExprStmt        # expr;
  AsmStmt        # Asm statement


NameValue        # Integer value of name or full initializer if not constant


StorageClass
  SC_Static
  SC_Member        # Non-static member
  SC_Auto
  SC_Register
  SC_Enum        # Identifies an enumerator


Type        # Type specifier
  BuiltinType        # Built-in type
    T_Void
    T_LDouble
    T_Double
    T_Float
    T_Long
    T_Int
    T_Short
    T_Char
    T_Zero
    T_Any
  PtrType
  RefType
  ArrayType
