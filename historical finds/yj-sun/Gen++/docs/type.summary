
Catch        # Catch clause for try statement


T_Attr        # Attributes of built-in types
  TA_Long
  TA_Unsigned
  TA_Signed
  TA_Numeric
  TA_Integral
  TA_Volatile
  TA_Const


FunctionTypeAttr        # Attributes of function types
  FTA_Ellipsis
  FTA_Static
  FTA_Const


CV_Spec        # Const/Volatile specifier
  Volatile
  Const


Initializer
  StaticInitializer        # Initializing code for static initialization
  Expression
    PrimaryExpr
      Literal        # Literal constant
        FloatConst
        CharConst
        IntConst
        StringConst
      NameRef        # Reference to a user-defined name
        AccessedName        # Name declared in an access declaration (see VisibilitySpec)
        LabelName        # Name of a label
        TypedName        # Name of object, function or type
          TypeName        # User-defined type name
          FunctionName        # Name of function
          IdName        # Name of object
      PMFValue        # Value of pointer to member function
      AggrValue        # Aggregate initializer
    Delete        # delete [size] ptr
    New        # new (placements) type (inits)
    Mdot        # Low level ref to member of virtual base or similar construct
    P2MemberRef        # .* or ->*
      P2MData        # p->*memdata
      P2MFunction        # p->*memfunc
    MemberRef        # . or ->
      Arrow        # x->y
      Dot        # x.y
    Question        # ?:
    Ccast        # Simple C-style cast to basic type
      GeneratedCast        # Compiler-generated cast
      UserCast        # Explicit (user-specified) cast
    Sizeof_T        # sizeof(type)
    Sizeof_E        # sizeof(expr)
    Index        # Subscripted expression x[y]
    FunCall        # Generic function call
      GeneratedCall        # Compiler-generated function call
        GConversion        # Generated call of conversion operator
        GDestruction        # Generated destructor call
        GConstruction        # Generated constructor call
        GOperatorCall        # Generated call of overloaded operator
      UserCall        # User-specified function call
    UnaryExpr        # Unary expression
      Deref        # *x
      AddrOf        # \&x
      Uplus        # +x
      Uminus        # -x
      UnaryCount        # ++/-- operators
        PostInc        # x++
        PostDec        # x--
        PreDec        # --x
        PreInc        # ++x
      Complement        # ~
      Not        # !
    BinaryExpr        # Binary expression
      Plus        # +
      Minus        # -
      Mult        # *
      Div        # /
      Mod        # \%
      Assignment
        Assign        # =
        RshiftAssign        # >>=
        LshiftAssign        # <<=
        MinusAssign        # -=
        PlusAssign        # +=
        ModAssign        # \%=
        MultAssign        # *=
        DivAssign        # /=
        OrAssign        # |=
        AndAssign        # \&=
        XorAssign        # \^=
      NotEq        # !=
      EqEq        # ==
      LessEq        # <=
      Less        # <
      GreaterEq        # >=
      Greater        # >
      Lshift        # <<
      Rshift        # >>
      Comma        # ,
      BitOr        # |
      BitAnd        # \&
      Xor        # \^
      LogOr        # ||
      LogAnd        # \&\&
    NullExpr        # Null or missing expression


MemInit        # Base/Member initializer in constructor definition


