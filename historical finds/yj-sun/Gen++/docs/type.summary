    Typeref        # Reference to a typedef name
    AggrType        # Class/Union type
      ClassType
      AnonType        # Included for completeness
      UnionType
    EnumType
  FunctionType
  Overload        # Identifies all instances of a function
  FieldType


Scope        # Scope identification
  Scope_Extern
  Scope_Static        # File or local static
  Scope_Label        # Scope of labels -- function-wide
  Scope_Local        # Scope of local declarations
  Scope_Argument        # Scope of function argument
  Scope_Member        # Scope of member
    Scope_Private
    Scope_Protected
    Scope_Public
  Scope_Weird        # Unknown value (should not occur)


NameKind        # Kind of name
  NK_Type
  NK_Enumerator
  NK_Label
  NK_This
  NK_Simple
  NK_Constructor
  NK_Destructor
  NK_Operator


Table        # Access to internal cfront symbol table


Declaration        # Generic declaration
  ObjectSpec        # Object declaration or definition
    ObjectDecl        # Object declaration (not allocated)
    ObjectDef        # Object definition
    EnumeratorSpec        # Declaration of enumerator
  FunctionSpec        # Function declaration
    FunctionDef        # Function definition
    FunctionDecl        # Function declaration (no body)
  AsmSpec        # Asm declaration
  EnumSpec        # Enum declaration
  AggrSpec        # Declaration of aggregate (class/struct/union)
    AggrDecl        # Forward declaration of aggregate
      UnionDecl        # Forward declaration of union
      ClassDecl        # Forward declaration of class or struct
    AggrDef        # Definition of aggregate (class/struct/union)
      AnonUnion        # Anonymous union declaration
      UnionDef        # Union definition
      ClassDef        # Class definition
  Typedef        # Typedef declaration
  Template        # Declaration of a template
    ClassTemplate        # Class template declaration
    FunctionTemplate        # Function template declaration
    DataTemplate        # Data template declaration
  LabelSpec        # For consistency with other declarations
  BogusDecl        # Implies internal error


FileSpec        # File info


Location        # Location in file


CFile        # C++ source file


C_String


C_File


