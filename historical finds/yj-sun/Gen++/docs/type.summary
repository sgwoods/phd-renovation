  BA_Allocated
  BA_Virtual
  BA_Plain


BaseAccess        # Base access identification
  BA_Private
  BA_Protected
  BA_Public


MemberSpec        # Member, friend or access declaration
  NestedDeclaration        # Member or friend declaration
    FriendDeclaration        # Friend declaration
      FriendFunction        # Friend function declaration
      FriendClass        # Friend class declaration
    MemberDeclaration        # Member declaration
  VisibilitySpec        # Base member access declaration
  AccessSpec        # public: / protected: / private:


BaseSpec        # Base class specification


