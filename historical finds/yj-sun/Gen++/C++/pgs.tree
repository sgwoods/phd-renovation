int  main(){ /* line 4, 'pgs.C' */
int  x1;
int  y1;
int  x2;
int  y2;
int  val1;
int  val2;
int  result;
x1= (y1= 1 );
x2= (y2= 4 );
val1= ((x2- x1)* (x2- x1));
val2= ((y2- y1)* (y2- y1));
result= sqrt( x1+ x2) ;
} /* line 17, 'pgs.C' */
