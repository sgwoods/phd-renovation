     1  #include <stdio.h>
     2
     3  int function( int i, int j )
     4  {
     5      int k;
     6      k = i * i + j * j;
     7      return k;
     8  }
     9
    10  main( int argc, char **argv )
    11  {
    12      int i, j, k;
    13      if( argc < 1 )
    14      {
    15          printf("exit\n");
    16      }
    17
    18      i = 10;
    19      j = 20;
    20
    21      k = function(i, j);
    22
    23      switch( k )
    24      {
    25          case 100:
    26              i += j;
    27              i -= 10;
    28              break;
    29          case 200:
    30              i-= j;
    31              for( j=0; j<5; j++)
    32              {
    33                  i+=10;
    34                  if( i>100 )
    35                  {
    36                      continue;
    37                  }
    38                  i += 10;
    39
    40              }
    41              break;
    42          default:
    43              i = j;
    44              break;
    45      }
    46
    47      if( k == 0 )
    48      {
    49          k = 10;
    50      }
    51      else if( k==5 )
    52      {
    53          k = 20;
    54      }
    55      else
    56      {
    57          k = 30;
    58      }
    59
    60      do {
    61          k += 10;
    62          k = i + 10;
    63          i = k;
    64      } while( k < 100 );
    65
    66  }
    67
    68

