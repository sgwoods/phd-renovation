/* This is a query that makes a control flow */
/* graph of a given problem. It generates "dot" */
/* graph description. Get dot from north@research.att.com */



/* This query has to be compiled with mknewname.c */
/* Set OTHERLIBS = mknewname.o in the makefile */
/* to get it in there */

/* This query has some minor flaws in certain circumstances */
/* It doesn't handle null brances of ifs, fors, etc correctly */
/* But it works in most cases, and may prove instructive to users */

ROOTPROC FileFlow
FILE control "/users1/grad/yjzhang/Gen++/flow.dot"


EXTERNAL PROC mystrconcat (STRING STRING) RETURNS STRING
EXTERNAL PROC myitoa (INTEGER) RETURNS STRING
EXTERNAL PROC newname () RETURNS STRING
EXTERNAL PROC IsHeader(STRING) RETURNS INTEGER


FUNCTION LOCSTRING
ARG GNODE Suffix;

ROOT G_AnyType;
{
LOCAL GNODE tmpt;
(ASSIGN tmpt (SLOT line $location))
(RETURN (CEXPR C_String "mystrconcat(mystrconcat(\"Statement\",myitoa(getCint(tmpt))),getCstring(Suffix))"))

}



PROC FileFlow
ROOT CFile;
{

LOCAL GNODE foo;
LOCAL GNODE fname;
(PRINT control "digraph hier {\n")
(PRINT control    "node [shape=ellipse];\n")
(PRINT control  " page=\"8.5,11\";\n")
(PRINT control  "margin=\"0.1,0.1\";\n")
(PRINT control "fontsize= 6\n")






<globals
  {Declaration
     (?FunctionDef
      <id
       (ASSIGN fname $token)
       (PRINT stdout "(BeginFunctionNamed %s)\n" <fname verbose>)>
       (ASSIGN fname (SLOT file  $location))

(IF (EQUAL (CEXPR C_Integer "IsHeader(getCstring(fname))") 0)   /* Is this from a header file ? */
    (THEN 
      <body
(PRINT stdout "DEBUG1 location %s\n" (SLOT line $location)) 
       <blockend (ASSIGN foo (CALL LOCSTRING ""))
(PRINT stdout "DEBUG1 location %s\n" (SLOT line $location)) 
	   > /* Location, no suffix */
       (CALL CompoundFlow foo foo foo) /* Exit refers the (passed down) next statement */
       (PRINT stdout "(EndFunctionNamed %s)\n" <fname verbose>)>)))}>
       (PRINT control "}")
}

